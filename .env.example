# tdesignAI environment example
# Copy this to .env and fill the keys before running the app

# OpenAI (Whisper + GPT) API key
OPENAI_API_KEY=

# DeepL API key (optional if using OpenAI for translation)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2

# ElevenLabs (voice cloning / TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Translation backend toggles
# Defaults: TRANSLATOR_BACKEND=openai, DeepL disabled
TRANSLATOR_BACKEND=openai
OPENAI_TRANSLATION_ENABLED=true
DEEPL_TRANSLATION_ENABLED=false
OPENAI_TRANSLATION_MODEL=gpt-4o
OPENAI_TRANSLATION_MAX_OUTPUT_TOKENS=2048

# Limits
MAX_VOICE_DURATION_SECONDS=45
MAX_VIDEO_DURATION_SECONDS=90
MAX_IMPORT_DURATION_SECONDS=90

# Speech rate for synthesized audio (1.0 = normal, <1.0 slower)
DEFAULT_SPEECH_RATE=1.0

# Usage reporting
# Set this to your backend endpoint to forward per-request cost data.
# Leave it disabled until the backend is ready.
USAGE_REPORTING_ENABLED=false
USAGE_REPORTING_URL=

# Notes:
# - ElevenLabs voice cloning requires a paid plan that supports Instant Voice Cloning.
# - Usage reporting uses the frontend-provided user token as a Bearer token.
# - After updating .env, restart the server (docker compose up --build or uvicorn main:app --reload).
